{
  "name": "cadgram",
  "version": "0.1.0",
  "private": true,
  "description": "Software discovery, comparison and lead-generation marketplace with a configurable CMS and admin panel.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate deploy",
    "db:init": "node scripts/create-initial-migration.mjs",
    "auth:reset-2fa": "tsx scripts/reset-2fa.ts",
    "db:demo-comparisons": "tsx scripts/demo-comparison-sections.ts",
    "db:demo-brands": "tsx scripts/demo-brands.ts",
    "db:add-flow-diagram": "tsx scripts/add-flow-diagram.ts",
    "db:add-browse-menus": "tsx scripts/add-browse-menus.ts",
    "mail": "node scripts/mailpit.mjs",
    "cron": "node scripts/cron.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.4.1",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "file-type": "^19.6.0",
    "lucide-react": "^0.474.0",
    "next": "^15.2.4",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "sanitize-html": "^2.14.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.13.0",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
