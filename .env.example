# ─── Core ───────────────────────────────────────────────────────────────────
# PostgreSQL 14+. For Neon/Supabase use the pooled URL here and the direct URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cadgram_v2"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cadgram_v2"

# Public base URL, no trailing slash. Used for canonical URLs, sitemaps and email links.
APP_URL="http://localhost:3000"

# 32+ random characters. Generate with: openssl rand -base64 48
APP_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"

# Protects /api/cron (scheduled publishing, notification retries, cleanup).
CRON_SECRET="replace-with-another-random-string"

SESSION_TTL_DAYS=14
MAX_UPLOAD_MB=10

# ─── Media storage ──────────────────────────────────────────────────────────
# Easiest: set this up in Admin → Integrations → Media storage (Local or Azure Blob Storage).
# Once saved there, the admin settings take over and the variables below are ignored.
# "local" writes to public/uploads (development or a server with a persistent disk).
# "azure" uses Azure Blob Storage (AZURE_STORAGE_* below). "s3" works with any S3-compatible store.
STORAGE_DRIVER="local"
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_KEY=""
AZURE_STORAGE_CONTAINER="uploads"
# Public base URL of the bucket or CDN in front of it, e.g. https://media.example.com
STORAGE_PUBLIC_URL=""
S3_BUCKET=""
S3_REGION="auto"
# Leave empty for AWS. R2: https://<account>.r2.cloudflarestorage.com  MinIO: http://minio:9000
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── Email ──────────────────────────────────────────────────────────────────
# "console" prints emails to the server log (development). Use "smtp" or "resend" in production.
# To test real SMTP locally, run `npm run mail` (Mailpit inbox at http://localhost:8025) and set
# EMAIL_DRIVER="smtp", SMTP_HOST="localhost", SMTP_PORT=1025 — or enter those in Admin → Settings → Email.
EMAIL_DRIVER="console"
EMAIL_FROM="Cadgram <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ─── Lead notifications (optional) ──────────────────────────────────────────
# Every new lead is POSTed as JSON, signed with X-Cadgram-Signature: sha256=<hmac>.
LEADS_WEBHOOK_URL=""
LEADS_WEBHOOK_SECRET=""
# Slack incoming webhook URL.
SLACK_LEADS_WEBHOOK_URL=""

# ─── Seeding ────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@cadgram.local"
# Required when seeding a production database.
SEED_ADMIN_PASSWORD=""
SEED_SAMPLE_DATA="true"

# ─── Build / hosting ────────────────────────────────────────────────────────
# "standalone" for Docker images.
NEXT_OUTPUT=""

# Browser push notifications (optional). Leave empty and keys are generated on first use and stored
# encrypted in the database. Set them to keep the same keys across databases. Push needs HTTPS (or localhost).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourdomain.com"
